# --- Required: LLM (Nebius AI Studio, OpenAI-compatible) ---
NEBIUS_API_KEY=your_nebius_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
# Any tool-calling model hosted on Nebius. Good options:
#   deepseek-ai/DeepSeek-V3.2          (strong reasoning + tool use, default)
#   meta-llama/Llama-3.3-70B-Instruct (reliable tool calling, cheaper)
#   Qwen/Qwen3-235B-A22B-Instruct-2507
MRA_MODEL=deepseek-ai/DeepSeek-V3.2
MRA_TEMPERATURE=0.2

# --- Search backend ---
# auto = use Tavily if TAVILY_API_KEY is set, otherwise DuckDuckGo
MRA_SEARCH=auto
# TAVILY_API_KEY=your_tavily_key_here   # optional upgrade

# --- Agent behavior ---
# How to read the target: auto | brand (a company/product) | category (a market)
MRA_MODE=auto
MRA_MAX_COMPETITORS=3
MRA_MAX_RESEARCH_STEPS=6
MRA_REQUEST_TIMEOUT=25

# Reflection pattern: self-critique + revise the synthesis (set false to skip).
MRA_REFLECTION=true
MRA_MAX_REFLECTION_ROUNDS=1

# Target-focused SWOT analysis section in the briefing.
MRA_SWOT=true

# Human-in-the-loop: pause to approve/edit competitors before researching
# (the CLI's --review flag sets this too).
MRA_HUMAN_REVIEW=false
